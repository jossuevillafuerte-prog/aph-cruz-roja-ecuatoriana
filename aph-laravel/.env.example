APP_NAME="APH Cruz Roja"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://aph.example.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aph
DB_USERNAME=aph
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=10
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
SESSION_EXPIRE_ON_CLOSE=true
SESSION_COOKIE=aph_secure_session
# PENDIENTE: configurar servicio institucional de correo y APP_URL HTTPS accesible.
# Mantener false hasta probar el remitente y la URL. No se generan envíos mientras esté deshabilitado.
APH_INVITATIONS_ENABLED=false

# Mapas: proveedor HTTPS, atribución visible y Referer de origen (strict-origin).
# Si el alojamiento impone CSP, debe permitir este origen en img-src.
APH_MAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
APH_MAP_ATTRIBUTION="© OpenStreetMap contributors"
